# Postgres connection string (Neon in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
# At least 32 characters; used to sign the session cookie. Must match the other apps.
SESSION_SECRET=""
# Base URL printed in admin reset links (scripts/reset-link.ts)
APP_URL="http://localhost:3000"
# Vercel Blob store (private). Leave empty in development to store uploads in ./.uploads
BLOB_READ_WRITE_TOKEN=""
# Protects /api/cron/reminders; Vercel Cron sends it automatically when set in the project
CRON_SECRET=""
# Email through Resend. Leave empty in development: emails are written to ./.emails instead
RESEND_API_KEY=""
EMAIL_FROM="Student Diary <diary@yourschool.az>"
# Web push (generate with: npx web-push generate-vapid-keys). The public key is sent to browsers.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@yourschool.az"
